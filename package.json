{
  "name": "@frontierharness/eval",
  "version": "0.0.1",
  "description": "Benchmark your own coding-agent harness against FrontierHarness Eval: sets up the benchmark workspace and installs the agent skill that drives the run.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "bin": {
    "frontierharness-eval": "cli/index.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "cli",
    "skills",
    "tasks",
    "results",
    "metadata",
    "benchmark.json"
  ],
  "keywords": [
    "benchmark",
    "coding-agent",
    "harness",
    "terminal-bench",
    "deepswe",
    "agent-skill",
    "evaluation"
  ],
  "homepage": "https://frontierharness.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontier-harness-eval/eval.git"
  },
  "bugs": {
    "url": "https://github.com/frontier-harness-eval/eval/issues"
  }
}
